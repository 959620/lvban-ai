page {
  --sea-50: #f0f9f8;
  --sea-100: #d8f0ed;
  --sea-500: #2f918a;
  --sea-600: #247470;
  --sea-700: #215d5a;
  --sea-900: #1c3f3e;
  --muted: #6b7c7b;
  --card: #ffffff;
  --border: #d9e6e4;
  background: linear-gradient(180deg, #f4fbfa 0%, #f7fafc 40%, #ffffff 100%);
  color: var(--sea-900);
  font-size: 28rpx;
  box-sizing: border-box;
}

view, text, image, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 16rpx 48rpx rgba(33, 93, 90, 0.08);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--sea-900);
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 20rpx;
}

.btn-primary {
  background: var(--sea-600) !important;
  color: #fff !important;
  border-radius: 999rpx !important;
  font-size: 28rpx !important;
  padding: 0 36rpx !important;
  line-height: 80rpx !important;
  border: none !important;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  background: #fff !important;
  color: var(--sea-800, #1e4b4a) !important;
  border-radius: 999rpx !important;
  font-size: 28rpx !important;
  padding: 0 36rpx !important;
  line-height: 76rpx !important;
  border: 1rpx solid var(--border) !important;
}

.btn-outline::after {
  border: none;
}

.chip {
  display: inline-flex;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border);
  background: #fff;
  font-size: 24rpx;
  color: var(--sea-900);
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.chip-active {
  background: var(--sea-600);
  border-color: var(--sea-600);
  color: #fff;
}

.badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--sea-100);
  color: var(--sea-700);
  font-size: 22rpx;
  margin-right: 8rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--sea-900);
  margin-bottom: 12rpx;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  color: var(--sea-900);
}

.input, .textarea {
  width: 100%;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.textarea {
  min-height: 160rpx;
}
