.cover-wrap {
  position: relative;
  height: 360rpx;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.cover {
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx;
  background: linear-gradient(180deg, transparent, rgba(16,41,40,0.75));
  color: #fff;
}

.cover-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.badge.light {
  background: rgba(255,255,255,0.9);
  color: #215d5a;
}

.actions {
  margin-bottom: 20rpx;
}

.mini {
  display: inline-block !important;
  margin: 0 8rpx 8rpx 0 !important;
  padding: 0 24rpx !important;
  line-height: 64rpx !important;
  font-size: 24rpx !important;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.info {
  background: var(--sea-50);
  border-radius: 16rpx;
  padding: 16rpx;
  font-size: 26rpx;
}
