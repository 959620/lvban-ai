# 复制为项目根目录 .env 后修改：
#   cp config/.env.example .env

# ---- 应用 ----
APP_NAME=Edu-Agent
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# ---- 数据库（SQLite）----
DATABASE_URL=sqlite:///./data/edu_agent.db

# ---- OpenAI（Step 7 接入；留空时使用规则兜底解析）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- 通知开关 ----
NOTIFY_LOCAL=true
NOTIFY_EMAIL=false
NOTIFY_WECOM=false

# ---- 邮件（NOTIFY_EMAIL=true 时生效）----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# ---- 企业微信机器人（第二阶段预留）----
WECOM_WEBHOOK_URL=
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_SECRET=

# ---- 调度 ----
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
