# 复制为项目根目录 .env 后修改：
#   cp config/.env.example .env

# ---- 应用 ----
APP_NAME=Edu-Agent
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# ---- 数据库（SQLite）----
DATABASE_URL=sqlite:///./data/edu_agent.db

# ---- OpenAI（Step 7；留空时使用规则兜底解析）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# ---- 通知开关 ----
NOTIFY_LOCAL=true
NOTIFY_EMAIL=false
NOTIFY_WECOM=false
# true=不连 SMTP，把邮件写入 data/email_outbox/（本地演练）
NOTIFY_EMAIL_DRY_RUN=false
# true=不调企业微信 API，写入 data/wecom_outbox/
NOTIFY_WECOM_DRY_RUN=false

# ---- 邮件（NOTIFY_EMAIL=true 时生效）----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ---- 企业微信（NOTIFY_WECOM=true 时生效）----
# 模式 A：群机器人 Webhook（推荐先用）
WECOM_WEBHOOK_URL=
# 模式 B：应用消息 API
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOUSER=@all
WECOM_MSG_TYPE=markdown
WECOM_API_BASE=https://qyapi.weixin.qq.com
WECOM_TIMEOUT_SECONDS=15

# ---- 调度 ----
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
